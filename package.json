{
  "name": "editorts-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:quickstart",
    "dev:quickstart": "bun run local-server.ts",
    "dev:opencode": "opencode serve --port 4096",
    "dev:web": "cd packages/web && bun run dev",
    "dev:desktop:web": "cd packages/desktop && bun run dev",
    "dev:desktop:native": "cd packages/desktop && bun run dev:native",
    "dev:desktop:native:ai": "bash -lc 'trap \"kill 0\" EXIT; bun run dev:opencode & bun run dev:desktop:native & wait'",
    "dev:desktop:ai": "bash -lc 'trap \"kill 0\" EXIT; bun run dev:opencode & bun run dev:desktop:web & wait'",
    "dev:desktop": "bun run dev:desktop:web",
    "dev:localsql": "cd packages/localsql && bun run dev",
    "server": "bun run local-server.ts",
    "build": "bun run build:core && bun run build:web && bun run build:desktop && bun run build:localsql",
    "build:core": "cd core && bun run build",
    "build:web": "cd packages/web && bun run build",
    "build:desktop": "cd packages/desktop && bun run build",
    "build:desktop:web": "cd packages/desktop && bun run build:web",
    "build:desktop:native": "cd packages/desktop && bun run build:native",
    "build:localsql": "cd packages/localsql && bun run build",
    "example": "bun run dev:quickstart",
    "test": "bun run test:core && bun run test:web",
    "test:api": "bun run test",
    "test:core": "cd core && bun run test",
    "test:web": "cd packages/web && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.57.0"
  }
}

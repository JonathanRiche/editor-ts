{
  "name": "editorts-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:quickstart",
    "dev:quickstart": "bun run local-server.ts",
    "dev:opencode": "opencode serve --port 4096",
    "dev:web": "bun run --filter @editorts/web dev",
    "dev:desktop:web": "bun run --filter @editorts/desktop dev",
    "dev:desktop:native": "bun run --filter @editorts/desktop dev:native",
    "dev:desktop:native:ai": "bash -lc 'trap \"kill 0\" EXIT; bun run dev:opencode & bun run dev:desktop:native & wait'",
    "dev:desktop:ai": "bash -lc 'trap \"kill 0\" EXIT; bun run dev:opencode & bun run dev:desktop:web & wait'",
    "dev:desktop": "bun run dev:desktop:web",
    "dev:localsql": "bun run --filter @editorts/localsql dev",
    "server": "bun run local-server.ts",
    "build": "bun run build:core && bun run build:web && bun run build:desktop && bun run build:localsql",
    "build:core": "bun run --filter editor-ts build",
    "build:web": "bun run --filter @editorts/web build",
    "build:desktop": "bun run --filter @editorts/desktop build",
    "build:desktop:web": "bun run --filter @editorts/desktop build:web",
    "build:desktop:native": "bun run --filter @editorts/desktop build:native",
    "install:desktop:local": "bun run --filter @editorts/desktop install:local",
    "build:localsql": "bun run --filter @editorts/localsql build",
    "example": "bun run dev:quickstart",
    "test": "bun run test:core && bun run test:web",
    "test:api": "bun run test",
    "test:core": "bun run --filter editor-ts test",
    "test:web": "bun run --filter @editorts/web test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.57.0"
  }
}

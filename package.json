{
  "name": "editor-ts",
  "version": "0.0.11",
  "description": "TypeScript library for editing HTML content with JSON representation",
  "module": "index.ts",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "html",
    "json",
    "editor",
    "page-builder",
    "cms",
    "typescript",
    "web"
  ],
  "author": "Jonathan Riche",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanRiche/editor-ts.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run local-server.ts",
    "server": "bun run server.ts",
    "build": "bun build index.ts --outdir=dist",
    "example": "bun run examples/basic-usage.ts",
    "test": "bun run examples/basic-usage.ts",
    "test:api": "bun run examples/test-api.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.57.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "files": [
    "src",
    "index.ts",
    "README.md"
  ],
  "dependencies": {
    "modern-monaco": "^0.3.6"
  }
}
